---
title: Shared core tables linking all three members
---
erDiagram
    department {
        int department_id PK
        varchar name
        varchar location
    }
    staff {
        int staff_id PK
        varchar first_name
        varchar last_name
        text role
        int department_id FK
        varchar license_no
        char phone
        varchar email
    }
    patient {
        int patient_id PK
        varchar hn
        varchar national_id
        varchar first_name
        varchar last_name
        date birth_date
        char gender
        char phone
        varchar email
        varchar address
        varchar blood_type
        text allergy_note
        timestamptz created_at
    }
    profiles {
        uuid user_id PK,FK
        text role
        int patient_id FK
        int staff_id FK
    }
    auth_users {
        uuid id PK
    }
    department |o--o{ staff : "department_id"
    patient |o--o{ profiles : "patient_id"
    staff |o--o{ profiles : "staff_id"
    auth_users ||--o| profiles : "user_id"
