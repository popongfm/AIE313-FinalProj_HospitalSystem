---
title: Shared core tables linking all three members
---
erDiagram
    department {
        int department_id PK
        varchar name
        varchar location
    }
    staff {
        int staff_id PK
        varchar first_name
        varchar last_name
        text role
        int department_id FK
        varchar license_no
        char phone
        varchar email
        uuid user_id FK
    }
    patient {
        int patient_id PK
        varchar hn
        varchar national_id
        varchar first_name
        varchar last_name
        date birth_date
        char gender
        char phone
        varchar email
        varchar address
        varchar blood_type
        text allergy_note
        timestamptz created_at
        uuid user_id FK
    }
    chat_logs {
        int chat_id PK
        uuid user_id
        text question
        text generated_sql
        text tool_name
        int row_count
        text error
        timestamptz created_at
    }
    auth_users {
        uuid id PK
    }
    department |o--o{ staff : "department_id"
    auth_users ||--o| staff : "user_id"
    auth_users ||--o| patient : "user_id"
    auth_users ||..o{ chat_logs : "user_id (no FK)"
